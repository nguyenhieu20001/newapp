<Application x:Class="ExcavatorAngle.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Không dùng StartupUri vì muốn tự lắp ráp các đối tượng trong App.xaml.cs (OnStartup).
        Nếu dự án đơn giản có thể viết: StartupUri="Views/MainWindow.xaml"
    -->
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1E2329"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F2A900"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#9AA4AF"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Application.Resources>
</Application>
