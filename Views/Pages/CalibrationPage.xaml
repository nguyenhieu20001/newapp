<UserControl x:Class="ExcavatorAngle.App.Views.Pages.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="20">
        <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Hiệu chỉnh góc" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,16"
                       Text="Đặt máy ở tư thế chuẩn rồi bấm 'Set 0': góc hiện tại sẽ được lấy làm góc 0. Có thể sửa tay offset bên dưới rồi bấm 'Lưu'."/>

            <!-- Bảng offset: binding hai chiều vào CalibrationSettings -->
            <Grid x:Name="OffsetGrid" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Margin" Value="0,4"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="Boom offset (°)"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding BoomOffset, StringFormat=F2}"/>
                <TextBlock Grid.Row="1" Text="Arm offset (°)"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding ArmOffset, StringFormat=F2}"/>
                <TextBlock Grid.Row="2" Text="Bucket offset (°)"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding BucketOffset, StringFormat=F2}"/>
                <TextBlock Grid.Row="3" Text="Swing offset (°)"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding SwingOffset, StringFormat=F2}"/>
                <TextBlock Grid.Row="4" Text="Pitch offset (°)"/>
                <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding PitchOffset, StringFormat=F2}"/>
                <TextBlock Grid.Row="5" Text="Roll offset (°)"/>
                <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding RollOffset, StringFormat=F2}"/>
            </Grid>

            <StackPanel Orientation="Horizontal">
                <Button Content="Set 0" Click="SetZero_Click"/>
                <Button Content="Lưu" Click="Save_Click"/>
                <Button Content="Reset" Click="Reset_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
