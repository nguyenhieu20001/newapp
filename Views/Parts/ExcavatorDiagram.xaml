<UserControl x:Class="ExcavatorAngle.App.Views.Parts.ExcavatorDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560" Height="340">
    <!--
        Hình máy xúc nhìn ngang, vẽ bằng hình khối đơn giản.
        Cách làm: Canvas lồng nhau. Mỗi Canvas con đặt gốc tọa độ ở CHỐT KHỚP,
        rồi xoay bằng RotateTransform → khớp con tự xoay theo khớp cha.
        Khi có hình thật (folder Pictures), thay Rectangle bằng <Image Source=.../>.
    -->
    <Canvas>
        <!-- Mặt đất -->
        <Line X1="0" Y1="300" X2="560" Y2="300" Stroke="#3A424B" StrokeThickness="2"/>

        <!-- Thân máy: xoay theo Pitch quanh điểm giữa xích -->
        <Canvas Canvas.Left="140" Canvas.Top="300">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="BodyRotate"/>
            </Canvas.RenderTransform>

            <!-- Xích -->
            <Rectangle Canvas.Left="-110" Canvas.Top="-34" Width="220" Height="34"
                       RadiusX="17" RadiusY="17" Fill="#2B3138" Stroke="#555F6B"/>
            <!-- Thân trên + cabin -->
            <Rectangle Canvas.Left="-100" Canvas.Top="-104" Width="180" Height="64"
                       RadiusX="6" RadiusY="6" Fill="#F2A900"/>
            <Rectangle Canvas.Left="-20" Canvas.Top="-150" Width="70" Height="50"
                       RadiusX="4" RadiusY="4" Fill="#C98C00"/>
            <Rectangle Canvas.Left="-10" Canvas.Top="-142" Width="50" Height="32" Fill="#8FB7D1"/>

            <!-- Gốc boom: chốt tại (60, -90) -->
            <Canvas Canvas.Left="60" Canvas.Top="-90">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="BoomRotate"/>
                </Canvas.RenderTransform>
                <Rectangle Canvas.Top="-9" Width="190" Height="18" RadiusX="9" RadiusY="9" Fill="#F2A900"/>
                <Ellipse Canvas.Left="-6" Canvas.Top="-6" Width="12" Height="12" Fill="#14181C"/>

                <!-- Gốc arm: chốt ở đầu boom (190, 0) -->
                <Canvas Canvas.Left="190">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="ArmRotate"/>
                    </Canvas.RenderTransform>
                    <Rectangle Canvas.Top="-7" Width="130" Height="14" RadiusX="7" RadiusY="7" Fill="#E09B00"/>
                    <Ellipse Canvas.Left="-6" Canvas.Top="-6" Width="12" Height="12" Fill="#14181C"/>

                    <!-- Gốc bucket: chốt ở đầu arm (130, 0) -->
                    <Canvas Canvas.Left="130">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="BucketRotate"/>
                        </Canvas.RenderTransform>
                        <Polygon Points="0,-10 48,-14 52,10 30,26 0,10" Fill="#6B7480" Stroke="#9AA4AF"/>
                        <Ellipse Canvas.Left="-5" Canvas.Top="-5" Width="10" Height="10" Fill="#14181C"/>
                    </Canvas>
                </Canvas>
            </Canvas>
        </Canvas>

        <!-- La bàn swing (nhìn từ trên) -->
        <Canvas Canvas.Left="500" Canvas.Top="50">
            <Ellipse Canvas.Left="-36" Canvas.Top="-36" Width="72" Height="72"
                     Stroke="#555F6B" StrokeThickness="2"/>
            <TextBlock Canvas.Left="-24" Canvas.Top="42" Text="Swing" Foreground="#9AA4AF" FontSize="12"/>
            <Canvas>
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="SwingRotate"/>
                </Canvas.RenderTransform>
                <Line X1="0" Y1="0" X2="0" Y2="-30" Stroke="#F2A900" StrokeThickness="4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Triangle"/>
            </Canvas>
        </Canvas>
    </Canvas>
</UserControl>
